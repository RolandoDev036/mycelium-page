---
// Logos.astro
---

<section class="logos-container">
  <p class="logos-title">
    IMPULSADO POR DATOS OFICIALES Y TECNOLOGÍA OPEN SOURCE
  </p>
  <div class="logos-grid">
    <div
      class="logo-item"
      title="Instituto Nacional de Estadística y Geografía"
    >
      <img src="/inegi.webp" alt="INEGI" />
      <span>INEGI</span>
    </div>

    <div
      class="logo-item"
      title="Consejo Nacional de Evaluación de la Política de Desarrollo Social"
    >
      <img src="/coneval.webp" alt="CONEVAL" />
      <span>CONEVAL</span>
    </div>

    <div class="logo-item" title="OpenStreetMap">
      <img src="/osm.webp" alt="OpenStreetMap" />
      <span>OpenStreetMap</span>
    </div>

    <div class="logo-item" title="QGIS Geographic Information System">
      <img src="/qgis.webp" alt="QGIS" />
      <span>QGIS</span>
    </div>
  </div>
</section>

<style>
  .logos-container {
    padding: 60px 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: transparent; /* Para que se vea la aurora del Layout */
  }

  .logos-title {
    color: var(--text-secondary);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    margin-bottom: 40px;
    opacity: 0.6;
  }

  .logos-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 60px;
    max-width: 1000px;
  }

  .logo-item {
    display: flex;
    align-items: center;
    gap: 12px;
    filter: grayscale(1) brightness(0.8);
    opacity: 0.5;
    transition: all 0.3s ease;
    cursor: default;
  }

  .logo-item:hover {
    filter: grayscale(0) brightness(1);
    opacity: 1;
    transform: translateY(-2px);
  }

  .logo-item img {
    height: 50px;
    width: auto;
  }

  .logo-item span {
    font-weight: 700;
    font-size: 1.1rem;
    color: white;
    letter-spacing: -0.02em;
  }

  @media (max-width: 768px) {
    .logos-grid {
      gap: 30px;
    }
    .logo-item span {
      display: none;
    }

    .logos-title {
      text-align: center;
    }
  }
</style>
