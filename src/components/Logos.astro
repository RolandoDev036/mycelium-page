---
// Logos.astro
---

<div class="logos-strip">
  <div class="container logos-inner">
    <span class="logos-label">Datos de</span>

    <div class="logos-grid">
      <div
        class="logo-item"
        title="Instituto Nacional de Estadística y Geografía"
      >
        <img src="/inegi.webp" alt="INEGI" />
        <span>INEGI</span>
      </div>

      <div
        class="logo-item"
        title="Consejo Nacional de Evaluación de la Política de Desarrollo Social"
      >
        <img src="/coneval.webp" alt="CONEVAL" />
        <span>CONEVAL</span>
      </div>

      <div class="logo-item" title="OpenStreetMap">
        <img src="/osm.webp" alt="OpenStreetMap" />
        <span>OpenStreetMap</span>
      </div>
    </div>
  </div>
</div>

<style>
  .logos-strip {
    border-top: 0.5px solid var(--color-border);
    border-bottom: 0.5px solid var(--color-border);
    padding: 20px 0;
  }

  .logos-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .logos-label {
    font-size: 20px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .logos-grid {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .logo-item {
    display: flex;
    align-items: center;
    gap: 8px;
    opacity: 0.9;
    transition: opacity 0.2s ease;
    cursor: default;
  }

  .logo-item:hover {
    opacity: 0.85;
  }

  .logo-item img {
    height: 22px;
    width: auto;
  }

  .logo-item span {
    font-size: 20px;
    font-weight: 500;
    color: var(--color-text-secondary);
    letter-spacing: -0.01em;
  }

  @media (max-width: 640px) {
    .logos-inner {
      flex-direction: column;
      gap: 16px;
    }

    .logo-item span {
      display: none;
    }
  }
</style>
