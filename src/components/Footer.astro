---
/**
 * Footer Component - Mycelium
 */
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-top">
      <!-- Marca -->
      <div class="footer-brand">
        <div class="footer-logo">
          <img src="/Logo.svg" alt="Mycelium Logo" />
        </div>
        <p class="footer-desc">
          Sistema de soporte a la decisión para la expansión de redes de
          transporte masivo mediante inteligencia geoespacial.
        </p>
        <span class="footer-tag">
          <span class="footer-tag-dot" aria-hidden="true"></span>
          Universidad Metropolitana de Monterrey · 2026
        </span>
      </div>

      <!-- Links -->
      <div class="footer-links">
        <h4 class="footer-links-title">Fuentes oficiales</h4>
        <ul class="footer-links-list">
          <li>
            <a href="https://www.inegi.org.mx/" target="_blank" rel="noopener">
              INEGI — Censo 2020
            </a>
          </li>
          <li>
            <a
              href="https://www.inegi.org.mx/servicios/denue/"
              target="_blank"
              rel="noopener"
            >
              INEGI — DENUE 2025
            </a>
          </li>
          <li>
            <a
              href="https://www.coneval.org.mx/"
              target="_blank"
              rel="noopener"
            >
              CONEVAL — Rezago Social
            </a>
          </li>
          <li>
            <a
              href="https://www.openstreetmap.org/"
              target="_blank"
              rel="noopener"
            >
              OpenStreetMap
            </a>
          </li>
        </ul>
      </div>

      <!-- Navegación -->
      <div class="footer-links">
        <h4 class="footer-links-title">Navegación</h4>
        <ul class="footer-links-list">
          <li><a href="#product">Cómo funciona</a></li>
          <li><a href="#findings">Resultados</a></li>
          <li><a href="#pricing">Precios</a></li>
          <li><a href="#faq">Preguntas frecuentes</a></li>
        </ul>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {currentYear} Mycelium. Todos los derechos reservados.
      </p>
      <div class="footer-meta">
        <span>Licenciatura en Tecnologías de la Información</span>
        <span class="footer-sep" aria-hidden="true">·</span>
        <span>Facultad de Tecnologías</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-bg-card);
    border-top: 0.5px solid var(--color-border);
    padding-top: 64px;
  }

  /* Top: tres columnas */
  .footer-top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding-bottom: 48px;
  }

  /* Marca */
  .footer-logo img {
    height: 32px;
    width: auto;
    margin-bottom: 16px;
  }

  .footer-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 280px;
    margin-bottom: 16px;
  }

  .footer-tag {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--color-text-muted);
    background: var(--color-bg-muted);
    padding: 6px 12px;
    border-radius: 20px;
  }

  .footer-tag-dot {
    width: 5px;
    height: 5px;
    background: var(--color-bg-dark);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Links */
  .footer-links-title {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .footer-links-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-links-list a {
    font-size: 13px;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .footer-links-list a:hover {
    color: var(--color-text-primary);
  }

  /* Barra inferior */
  .footer-bottom {
    border-top: 0.5px solid var(--color-border);
    padding: 24px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
  }

  .footer-copy {
    font-size: 12px;
    color: var(--color-text-muted);
    margin: 0;
  }

  .footer-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--color-text-muted);
    flex-wrap: wrap;
  }

  .footer-sep {
    opacity: 0.4;
  }

  /* Desktop */
  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 48px;
    }

    .footer-bottom {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }
</style>
