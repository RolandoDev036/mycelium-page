---
/**
 * Footer Component - Mycelium
 * Proyecto de Tesis - Universidad Metropolitana de Monterrey (UMM)
 */
const currentYear = new Date().getFullYear();
---

<footer class="footer-container">
  <div class="footer-content">
    <div class="footer-brand">
      <div class="logo">
        <img src="/Logo-Blanco.svg" alt="Mycelium Logo" />
      </div>
      <p class="brand-description">
        Sistema de soporte a la decisión para la expansión de redes de
        transporte masivo.
      </p>
      <div class="university-tag">
        <span class="tag-dot"></span>
        Proyecto desarrollado en la UMM
      </div>
    </div>

    <div class="footer-links">
      <h4 class="links-title">Fuentes Oficiales</h4>
      <ul class="links-list">
        <li>
          <a href="https://www.inegi.org.mx/" target="_blank" rel="noopener"
            >INEGI - Censo 2020</a
          >
        </li>
        <li>
          <a href="https://www.coneval.org.mx/" target="_blank" rel="noopener"
            >CONEVAL - Rezago Social</a
          >
        </li>
        <li>
          <a
            href="https://www.openstreetmap.org/"
            target="_blank"
            rel="noopener">OpenStreetMap Data</a
          >
        </li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="bottom-content">
      <p class="copyright">
        &copy; {currentYear} Mycelium. Todos los derechos reservados.
      </p>
      <div class="legal-links">
        <span>Licenciatura en TI</span>
        <span class="separator" aria-hidden="true">•</span>
        <span>Facultad de Tecnologías</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-container {
    background-color: #0b0a0d;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 80px 24px 40px;
    margin-top: 80px;
    width: 100%;
    box-sizing: border-box;
  }

  .footer-content {
    max-width: 900px; /* Reducido para que las dos columnas no se separen tanto */
    margin: 0 auto 60px auto;
    display: grid;
    /* Ajuste de columnas para que se vean centradas en Desktop */
    grid-template-columns: 1fr 1fr;
    gap: 80px; /* Espacio generoso entre ambas */
    justify-items: center; /* Centra el contenido de las celdas del grid */
    text-align: left;
  }

  /* --- BRANDING --- */
  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .logo img {
    height: 60px;
    width: auto;
  }

  .brand-description {
    color: var(--text-secondary, #a1a1a1);
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 20px 0;
    max-width: 320px;
  }

  .university-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.03);
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 0.75rem;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    background-color: var(--accent-purple, #5c3cf5);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-purple);
  }

  /* --- LINKS --- */
  .links-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 24px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .links-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .links-list li {
    margin-bottom: 12px;
  }

  .links-list a {
    color: var(--text-secondary, #a1a1a1);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .links-list a:hover {
    color: #fff;
  }

  /* --- BOTTOM BAR --- */
  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding-top: 32px;
  }

  .bottom-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--text-secondary, #a1a1a1);
    font-size: 0.8rem;
  }

  .legal-links {
    display: flex;
    gap: 12px;
    align-items: center;
  }

  .separator {
    opacity: 0.3;
  }

  /* --- RESPONSIVE AJUSTES --- */
  @media (max-width: 768px) {
    .footer-content {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 48px;
    }

    .footer-brand {
      align-items: center; /* Todo al centro en móvil */
    }

    .brand-description {
      margin: 20px auto;
    }

    .footer-links {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .links-list {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .bottom-content {
      flex-direction: column;
      gap: 15px;
      text-align: center;
    }

    .legal-links {
      justify-content: center;
    }
  }
</style>
