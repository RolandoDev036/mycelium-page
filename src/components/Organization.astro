---
// Organization.astro
const features = [
  {
    id: "visualizacion",
    title: "Mapa interactivo de clusters",
    description:
      "8 modos de visualización temática sobre la ZMM completa. Selecciona cualquier núcleo para ver población atendida, rezago social y distancia al metro.",
    img: "/visualizacion.webp",
    tag: "Leaflet · GeoJSON",
  },
  {
    id: "entregables",
    title: "Reporte ejecutivo PDF",
    description:
      "Generación automática de reportes con métricas de población atendida, índice de prioridad y rezago social. Listo para llevar a una reunión de gobierno.",
    img: "/reportes.webp",
    tag: "PDF · Exportación automática",
  },
  {
    id: "transparencia",
    title: "Archivos GeoPackage",
    description:
      "Exportación de geometrías y atributos en formato estándar compatible con QGIS y cualquier SIG profesional. Trazabilidad total del análisis.",
    img: "/exportacion.webp",
    tag: "GeoPackage · QGIS",
  },
];
---

<section class="org-section" id="deliverables">
  <div class="container">
    <div class="org-header">
      <p class="section-label">Entregables</p>
      <h2 class="org-title">
        Evidencia lista para<br />una reunión de gobierno
      </h2>
      <p class="org-subtitle">
        Mycelium no entrega datos crudos. Entrega argumentos.
      </p>
    </div>

    <div class="org-grid">
      <!-- Lista de features -->
      <div class="features-list">
        {
          features.map((f, index) => (
            <div
              class={`feature-item ${index === 0 ? "active" : ""}`}
              data-org={f.id}
            >
              <div class="feature-text">
                <h3 class="feature-title">{f.title}</h3>
                <p class="feature-desc">{f.description}</p>
                <span class="feature-tag">{f.tag}</span>
              </div>
              <svg
                class="feature-arrow"
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </div>
          ))
        }
      </div>

      <!-- Preview visual -->
      <div class="visual-preview">
        <div class="browser-bar">
          <span class="browser-dot"></span>
          <span class="browser-dot"></span>
          <span class="browser-dot"></span>
        </div>
        <div class="preview-window">
          {
            features.map((f, index) => (
              <img
                src={f.img}
                alt={f.title}
                class={`preview-img ${index === 0 ? "active" : ""}`}
                id={`img-org-${f.id}`}
              />
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  {
    const container = document.querySelector(".org-section");
    if (container) {
      const orgItems = container.querySelectorAll(".feature-item[data-org]");
      const orgImgs = container.querySelectorAll(
        '.preview-img[id^="img-org-"]',
      );

      orgItems.forEach((item) => {
        item.addEventListener("mouseenter", () => {
          const featureId = item.getAttribute("data-org");
          const targetImg = container.querySelector(`#img-org-${featureId}`);
          if (targetImg) {
            orgItems.forEach((i) => i.classList.remove("active"));
            orgImgs.forEach((img) => img.classList.remove("active"));
            item.classList.add("active");
            targetImg.classList.add("active");
          }
        });
      });

      window.addEventListener("load", () => {
        const firstImg = orgImgs[0] as HTMLElement;
        const firstItem = orgItems[0] as HTMLElement;
        if (firstImg && firstItem) {
          firstImg.classList.add("active");
          firstItem.classList.add("active");
        }
      });
    }
  }
</script>

<style>
  .org-section {
    padding: 80px 0;
  }

  /* Header */
  .org-header {
    margin-bottom: 56px;
  }

  .org-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }

  .org-subtitle {
    font-size: 15px;
    color: var(--color-text-secondary);
  }

  /* Grid principal */
  .org-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
  }

  /* Lista de features */
  .features-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .feature-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 20px;
    border-radius: var(--radius-md);
    border: 0.5px solid transparent;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .feature-item:hover,
  .feature-item.active {
    background: var(--color-bg-card);
    border-color: var(--color-border);
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .feature-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-text-muted);
    transition: color 0.25s ease;
    margin: 0;
  }

  .feature-item.active .feature-title,
  .feature-item:hover .feature-title {
    color: var(--color-text-primary);
  }

  .feature-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    display: none;
  }

  .feature-item.active .feature-desc {
    display: block;
  }

  .feature-tag {
    display: none;
    font-size: 11px;
    padding: 3px 10px;
    border-radius: 20px;
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
    align-self: flex-start;
  }

  .feature-item.active .feature-tag {
    display: inline-block;
  }

  .feature-arrow {
    color: var(--color-text-muted);
    flex-shrink: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .feature-item.active .feature-arrow,
  .feature-item:hover .feature-arrow {
    opacity: 1;
  }

  /* Preview visual */
  /* Reemplaza estos estilos en Organization.astro */

  .visual-preview {
    background: var(--color-bg-muted);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 0.5px solid var(--color-border);
    /* Sombra sutil para dar profundidad */
    box-shadow: 0 8px 32px rgba(38, 49, 55, 0.08);
  }

  .browser-bar {
    background: #e4e4e6;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    gap: 6px;
    /* Barra ligeramente más alta para que se vea más real */
    min-height: 36px;
  }

  .browser-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: block;
    flex-shrink: 0;
  }

  /* Tres colores reales de macOS */
  .browser-dot:nth-child(1) {
    background: #ff5f57;
  }
  .browser-dot:nth-child(2) {
    background: #ffbd2e;
  }
  .browser-dot:nth-child(3) {
    background: #28c840;
  }

  .preview-window {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-dark);
  }

  .preview-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    /* Cover mantiene proporciones, top muestra la parte superior de la UI */
    object-fit: cover;
    object-position: top left;
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 1;
  }

  .preview-img.active {
    opacity: 1;
    z-index: 2;
  }

  /* Desktop */
  @media (min-width: 900px) {
    .org-grid {
      grid-template-columns: 1fr 1.1fr;
      gap: 48px;
      align-items: center;
    }

    .preview-window {
      height: 400px;
    }
  }
</style>
