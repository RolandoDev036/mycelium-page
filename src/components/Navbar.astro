---
const navItems = [
  { name: "Inicio", href: "#start" },
  { name: "¿Qué es Mycelium?", href: "#product" },
  { name: "Inspiración", href: "#inspiration" },
  { name: "Resultados", href: "#results" },
  { name: "Precios", href: "#pricing" },
];
---

<nav class="nav-container">
  <div class="nav-content">
    <div class="logo">
      <img src="/Logo-Blanco.svg" alt="Mycelium Logo" />
    </div>

    <ul class="nav-links">
      {
        navItems.map((item) => (
          <li class="nav-item">
            <a href={item.href} class="nav-anchor">
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-action">
      <button id="open-video" class="video-btn">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          class="icon-play"
        >
          <circle cx="12" cy="12" r="10"></circle>
          <polygon points="10 8 16 12 10 16 10 8"></polygon>
        </svg>
        <span class="video-text">Ver video</span>
      </button>
    </div>
  </div>
</nav>

<dialog id="video-modal">
  <div class="modal-wrapper">
    <button id="close-modal" class="close-btn" aria-label="Cerrar video"
      >&times;</button
    >
    <div class="video-aspect-ratio">
      <div id="player-container"></div>
    </div>
  </div>
</dialog>

<script>
  const initModal = () => {
    const VIDEO_ID = "NdNHJijhDKs";
    const modal = document.getElementById("video-modal") as HTMLDialogElement;
    const openBtn = document.getElementById("open-video");
    const closeBtn = document.getElementById("close-modal");
    const player = document.getElementById("player-container");

    if (openBtn && modal && player && closeBtn) {
      openBtn.addEventListener("click", () => {
        player.innerHTML = `
          <iframe 
            src="https://www.youtube.com/embed/${VIDEO_ID}?autoplay=1&rel=0&vq=hd1080" 
            frameborder="0" 
            allow="autoplay; encrypted-media; picture-in-picture" 
            allowfullscreen
            class="video-iframe">
          </iframe>`;
        modal.showModal();
      });

      const closeModal = () => {
        modal.close();
        player.innerHTML = "";
      };

      closeBtn.addEventListener("click", closeModal);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    }
  };

  initModal();
</script>

<style is:global>
  :root {
    --nav-height-mobile: 70px;
    --nav-height-desktop: 80px;
    --transition-speed: 0.3s;
  }

  .nav-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--nav-height-mobile);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    transition: height var(--transition-speed) ease;
  }

  .nav-content {
    width: 100%;
    max-width: 1200px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
  }

  .logo img {
    height: 40px;
  }

  .nav-links {
    display: none;
    list-style: none;
    gap: 32px;
    margin: 0;
    padding: 0;
  }

  .nav-anchor {
    color: var(--text-primary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: bold;
  }

  .video-btn {
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    color: white;
    font-weight: 500;
  }

  .icon-play {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  #video-modal {
    border: none;
    background: transparent;
    width: 95vw;
    max-width: 1000px;
    padding: 0;
    overflow: visible;
  }

  #video-modal::backdrop {
    background: rgba(0, 0, 0, 0.9);
    backdrop-filter: blur(10px);
  }

  .modal-wrapper {
    position: relative;
    width: 100%;
    background: #000;
    border: 1px solid rgba(255, 255, 255, 0.1);
    overflow: visible;
  }

  .video-aspect-ratio {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
  }

  #player-container,
  .video-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .close-btn {
    position: absolute;
    top: -50px;
    right: 0;
    color: white;
    font-size: 40px;
    background: none;
    border: none;
    cursor: pointer;
    z-index: 1001;
    line-height: 1;
    transition: transform 0.2s ease;
  }

  .close-btn:hover {
    transform: scale(1.1);
  }

  @media (min-width: 768px) {
    .nav-container {
      height: var(--nav-height-desktop);
    }
    .nav-content {
      padding: 0 40px;
    }
    .logo img {
      height: 50px;
    }
    .nav-links {
      display: flex;
    }
  }

  @media (max-width: 768px) {
    .close-btn {
      top: -45px;
      right: 5px;
      font-size: 35px;
    }
  }
</style>
