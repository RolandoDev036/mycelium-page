---
const navItems = [
  { name: "Producto", href: "#product" },
  { name: "Resultados", href: "#findings" },
  { name: "Entregables", href: "#deliverables" },
  { name: "Precios", href: "#pricing" },
  { name: "Preguntas frecuentes", href: "#faq" },
];
---

<nav class="nav-container">
  <div class="container nav-content">
    <a href="#start" class="nav-logo">
      <img src="/Logo.svg" alt="Mycelium Logo" />
    </a>

    <ul class="nav-links">
      {
        navItems.map((item) => (
          <li>
            <a href={item.href} class="nav-anchor">
              {item.name}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-actions">
      <a href="#pricing" class="btn-primary">Proximamente demo</a>
    </div>
  </div>
</nav>

<dialog id="video-modal">
  <div class="modal-wrapper">
    <button id="close-modal" class="close-btn" aria-label="Cerrar video"
      >&times;</button
    >
    <div class="video-aspect-ratio">
      <div id="player-container"></div>
    </div>
  </div>
</dialog>

<script>
  const initModal = () => {
    const VIDEO_ID = "NdNHJijhDKs";
    const modal = document.getElementById("video-modal") as HTMLDialogElement;
    const openBtn = document.getElementById("open-video");
    const closeBtn = document.getElementById("close-modal");
    const player = document.getElementById("player-container");

    if (openBtn && modal && player && closeBtn) {
      openBtn.addEventListener("click", () => {
        player.innerHTML = `
          <iframe
            src="https://www.youtube.com/embed/${VIDEO_ID}?autoplay=1&rel=0&vq=hd1080"
            frameborder="0"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
            class="video-iframe">
          </iframe>`;
        modal.showModal();
      });

      const closeModal = () => {
        modal.close();
        player.innerHTML = "";
      };

      closeBtn.addEventListener("click", closeModal);
      modal.addEventListener("click", (e) => {
        if (e.target === modal) closeModal();
      });
    }
  };

  initModal();
</script>

<style>
  .nav-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background: rgba(250, 250, 250, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 0.5px solid var(--color-border);
    z-index: 1000;
    display: flex;
    align-items: center;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  /* Logo */
  .nav-logo img {
    height: 36px;
    display: block;
  }

  /* Links */
  .nav-links {
    display: none;
    list-style: none;
    gap: 28px;
  }

  .nav-anchor {
    font-size: 13px;
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
  }

  .nav-anchor:hover {
    color: var(--color-text-primary);
  }

  /* Acciones */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .btn-ghost {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-family: var(--font-main);
    color: var(--color-text-secondary);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s ease;
  }

  .btn-ghost:hover {
    color: var(--color-text-primary);
  }

  .icon-play {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    flex-shrink: 0;
  }

  .btn-primary {
    font-size: 13px;
    font-weight: 500;
    font-family: var(--font-main);
    background: var(--color-bg-dark);
    color: var(--color-text-inverse);
    padding: 8px 18px;
    border-radius: var(--radius-sm);
    transition: opacity 0.2s ease;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  /* Modal — igual que antes, solo colores actualizados */
  #video-modal {
    border: none;
    background: transparent;
    width: 95vw;
    max-width: 1000px;
    padding: 0;
    overflow: visible;
  }

  #video-modal::backdrop {
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
  }

  .modal-wrapper {
    position: relative;
    width: 100%;
    background: #000;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .video-aspect-ratio {
    position: relative;
    width: 100%;
    padding-bottom: 56.25%;
    height: 0;
  }

  #player-container,
  .video-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .close-btn {
    position: absolute;
    top: -48px;
    right: 0;
    color: white;
    font-size: 36px;
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
    transition: opacity 0.2s ease;
  }

  .close-btn:hover {
    opacity: 0.7;
  }

  /* Responsive */
  @media (min-width: 768px) {
    .nav-links {
      display: flex;
    }
  }

  @media (max-width: 767px) {
    .btn-primary {
      display: none;
    }
    .close-btn {
      top: -44px;
      font-size: 32px;
    }
  }
</style>
