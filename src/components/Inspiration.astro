---
// Inspiration.astro
const features = [
  {
    id: "soberania",
    title: "Soberanía Tecnológica",
    description:
      "Procesamiento local en GeoPackage que asegura la privacidad y trazabilidad de los insumos oficiales del INEGI.",
    img: "/inegi_foto.webp",
  },
  {
    id: "red",
    title: "Optimización de Grafos",
    description:
      "Modelado de la traza urbana mediante grafos para identificar trayectorias de costo mínimo basadas en Dijkstra.",
    img: "/avenida_red.webp",
  },
  {
    id: "equidad",
    title: "Equidad y Justicia Social",
    description:
      "Visualizando núcleos de demanda en zonas con rezago social para maximizar el impacto de la inversión pública.",
    img: "/independencia_monterrey.webp",
  },
];
---

<section class="inspiration-container" id="inspiration">
  <div class="inspiration-header">
    <h2 class="inspiration-title">Inspiración del proyecto</h2>
    <p class="inspiration-subtitle">
      Mycelium nace para revertir la crisis de movilidad en Monterrey, donde el
      uso del transporte masivo ha caído un 33.2% en el último año.
    </p>
  </div>

  <div class="inspiration-content">
    <div class="visual-preview">
      {
        features.map((f, index) => (
          <img
            src={f.img}
            alt={f.title}
            class={`preview-img ${index === 0 ? "active" : ""}`}
            id={`img-${f.id}`}
          />
        ))
      }
      <div class="overlay-glow"></div>
    </div>

    <div class="features-list">
      {
        features.map((f, index) => (
          <div
            class={`feature-item ${index === 0 ? "active" : ""}`}
            data-feature={f.id}
          >
            <h3>{f.title}</h3>
            <p>{f.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  {
    // Bloque de encapsulamiento
    const container = document.querySelector(".inspiration-container");
    if (container) {
      const items = container.querySelectorAll(".feature-item");
      const imgs = container.querySelectorAll(".preview-img");

      items.forEach((item) => {
        item.addEventListener("mouseenter", () => {
          const featureId = item.getAttribute("data-feature");
          const targetImg = container.querySelector(`#img-${featureId}`);

          if (targetImg) {
            // Solo removemos 'active' dentro de este contenedor específico
            items.forEach((i) => i.classList.remove("active"));
            imgs.forEach((img) => img.classList.remove("active"));

            item.classList.add("active");
            targetImg.classList.add("active");
          }
        });
      });
    }
  }
</script>

<style>
  .inspiration-container {
    padding: 80px 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .inspiration-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .inspiration-title {
    font-size: 3rem;
    font-weight: 800;
  }

  .inspiration-subtitle {
    color: var(--text-secondary);
    max-width: 800px;
    margin: 20px auto 0;
    line-height: 1.6;
  }

  .inspiration-content {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .visual-preview {
    position: sticky;
    top: 120px;
    height: 450px;
    border-radius: 24px;
    overflow: hidden;
    background: #16171a;
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .preview-img {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .preview-img.active {
    opacity: 0.8;
  }

  .overlay-glow {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      45deg,
      rgba(92, 60, 245, 0.1) 0%,
      transparent 60%
    );
    pointer-events: none;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature-item {
    padding: 32px;
    border-radius: 20px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* El resaltado en gris de Figma */
  .feature-item.active {
    background: #16171a;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .feature-item h3 {
    font-size: 1.4rem;
    font-weight: 700;
    margin-bottom: 12px;
    color: var(--text-secondary);
    transition: color 0.3s ease;
  }

  .feature-item.active h3 {
    color: #ffffff;
  }

  .feature-item p {
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.6;
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  .feature-item.active p {
    opacity: 1;
  }

  @media (max-width: 900px) {
    .inspiration-content {
      grid-template-columns: 1fr;
    }
    .visual-preview {
      position: relative;
      top: 0;
      height: 300px;
      order: 2;
    }

    .inspiration-title {
      font-size: 2rem;
    }
  }
</style>
