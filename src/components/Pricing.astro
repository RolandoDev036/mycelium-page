---
// Pricing.astro
---

<section class="pricing-section" id="pricing">
  <div class="container">
    <div class="pricing-header">
      <p class="section-label">Inversión</p>
      <h2 class="pricing-title">
        Planeación basada en evidencia,<br />no en intuición
      </h2>
      <p class="pricing-subtitle">
        Dos modalidades para organismos públicos y consultoras especializadas.
      </p>
    </div>

    <div class="pricing-grid">
      <!-- Licencia Profesional -->
      <div class="price-card">
        <div class="price-top">
          <span class="price-type">Suscripción anual</span>
          <h3 class="price-name">Licencia Profesional</h3>
          <p class="price-desc">
            Para consultoras y equipos técnicos de movilidad urbana.
          </p>
        </div>

        <div class="price-amount-block">
          <span class="price-amount">$180,000</span>
          <span class="price-period">MXN · Pago anual</span>
        </div>

        <div class="price-features">
          <div class="price-feature">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Motor K-Means y Dijkstra ilimitado</span>
          </div>
          <div class="price-feature">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Exportación GeoPackage y PDF</span>
          </div>
          <div class="price-feature">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Integración nativa INEGI + CONEVAL</span>
          </div>
          <div class="price-feature">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Cobertura nacional</span>
          </div>
        </div>

        <div class="price-cta">Próximamente disponible</div>
      </div>

      <!-- Adquisición Completa -->
      <div class="price-card price-card--featured">
        <div class="price-top">
          <span class="price-type price-type--light">Adquisición total</span>
          <h3 class="price-name price-name--light">Propiedad Completa</h3>
          <p class="price-desc price-desc--light">
            Para organismos que requieren soberanía total del software y datos.
          </p>
        </div>

        <div class="price-amount-block">
          <span class="price-amount price-amount--light">Aún por definir</span>
          <span class="price-period price-period--light">MXN · Pago único</span>
        </div>

        <div class="price-features">
          <div class="price-feature price-feature--light">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Transferencia de activos tecnológicos</span>
          </div>
          <div class="price-feature price-feature--light">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Implementación on-premise</span>
          </div>
          <div class="price-feature price-feature--light">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Documentación técnica completa</span>
          </div>
          <div class="price-feature price-feature--light">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            <span>Soporte para actualización de datos</span>
          </div>
        </div>

        <div class="price-cta price-cta--light">Próximamente disponible</div>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    padding: 80px 0;
  }

  /* Header */
  .pricing-header {
    margin-bottom: 48px;
  }

  .pricing-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }

  .pricing-subtitle {
    font-size: 15px;
    color: var(--color-text-secondary);
  }

  /* Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  /* Tarjeta base */
  .price-card {
    background: var(--color-bg-card);
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .price-card--featured {
    background: var(--color-bg-dark);
    border-color: var(--color-bg-dark);
  }

  /* Tipo y nombre */
  .price-type {
    display: block;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: 8px;
  }

  .price-type--light {
    color: rgba(255, 255, 255, 0.4);
  }

  .price-name {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--color-text-primary);
    margin-bottom: 8px;
  }

  .price-name--light {
    color: #fff;
  }

  .price-desc {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .price-desc--light {
    color: rgba(255, 255, 255, 0.45);
  }

  /* Monto */
  .price-amount-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-bottom: 24px;
    border-bottom: 0.5px solid var(--color-border-muted);
  }

  .price-card--featured .price-amount-block {
    border-bottom-color: rgba(255, 255, 255, 0.08);
  }

  .price-amount {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    color: var(--color-text-primary);
    line-height: 1;
  }

  .price-amount--light {
    color: #fff;
  }

  .price-period {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .price-period--light {
    color: rgba(255, 255, 255, 0.35);
  }

  /* Features */
  .price-features {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .price-feature {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }

  .price-feature--light {
    color: rgba(255, 255, 255, 0.55);
  }

  .price-feature svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-text-primary);
  }

  .price-feature--light svg {
    color: rgba(255, 255, 255, 0.55);
  }

  /* CTA */
  .price-cta {
    padding: 10px 16px;
    border-radius: var(--radius-sm);
    text-align: center;
    font-size: 13px;
    font-weight: 500;
    border: 0.5px solid var(--color-border);
    color: var(--color-text-muted);
  }

  .price-cta--light {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.15);
    color: rgba(255, 255, 255, 0.6);
  }

  /* Desktop */
  @media (min-width: 768px) {
    .pricing-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
