---
// Validation.astro
const validations = [
  {
    title: "Marco Jurídico",
    description:
      "Aplicación del Artículo 35 de la LGMSV para priorizar la jerarquía de movilidad en el diseño de infraestructura.",
    image: "/ley-bg.webp", // Asegúrate de tener estas imágenes en tu carpeta public
  },
  {
    title: "Lógica Adaptativa",
    description:
      "Redes inspiradas en la eficiencia biológica del Physarum polycephalum para optimizar el transporte de nutrientes/pasajeros.",
    image: "/bio-bg.webp",
  },
  {
    title: "ODS 11.2",
    description:
      "Contribución al acceso universal a transporte seguro y sostenible, reduciendo desigualdades en zonas desconectadas.",
    image: "/agenda-bg.webp",
  },
  {
    title: "Rigor Estadístico",
    description:
      "Procesamiento de datos de INEGI y CONEVAL que asegura propuestas transparentes, auditables y libres de discrecionalidad.",
    image: "/data-bg.webp",
  },
];
---

<section class="validation-container">
  <div class="validation-header">
    <h2 class="validation-title">Validación Multidimensional</h2>
    <p class="validation-subtitle">
      Mycelium alinea la inteligencia geoespacial con los requerimientos legales
      y sociales más exigentes para garantizar una movilidad equitativa.
    </p>
  </div>

  <div class="validation-bento">
    {
      validations.map((v) => (
        <div class="bento-card">
          <img src={v.image} alt="" class="card-bg-image" />
          <div class="card-overlay" />

          <div class="card-content">
            <h3>{v.title}</h3>
            <p>{v.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .validation-container {
    padding: 80px 20px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .validation-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .validation-title {
    font-size: 3rem;
    font-weight: 800;
    margin-bottom: 15px;
    color: #fff;
  }

  .validation-subtitle {
    color: var(--text-secondary);
    opacity: 0.8;
    width: 80%;
    margin-left: auto;
    margin-right: auto;
  }

  .validation-bento {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .bento-card {
    background: #111214;
    border: 1px solid rgba(255, 255, 255, 0.1);
    height: 200px;
    border-radius: 28px;
    padding: 20px;
    position: relative;
    overflow: hidden;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-sizing: border-box;
  }

  /* ESTO ES LO NUEVO: Imagen de fondo desenfocada */
  .card-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(2px); /* El desenfoque que pediste */
    opacity: 0.4; /* Ajusta la opacidad para que no compita con el texto */
    z-index: 1;
    transform: scale(1.1); /* Evita bordes blancos por el blur */
  }

  /* Capa para asegurar contraste */
  .card-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle,
      transparent 0%,
      rgba(0, 0, 0, 0.4) 100%
    );
    z-index: 2;
  }

  .bento-card:hover {
    transform: translateY(-5px);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .card-content {
    position: relative;
    z-index: 3; /* Por encima de la imagen y el overlay */
  }

  .bento-card h3 {
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 16px;
    color: #fff;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }

  .bento-card p {
    color: #e0e0e0;
    line-height: 1.6;
    font-size: 1rem;
    margin: 0;
    text-shadow: 0 1px 5px rgba(0, 0, 0, 0.5);
  }

  @media (max-width: 768px) {
    .validation-bento {
      grid-template-columns: 1fr;
    }

    .validation-title {
      font-size: 2rem;
    }

    .bento-card {
      height: auto;
    }
  }
</style>
