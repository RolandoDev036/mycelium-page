---
// About.astro
---

<section class="about-section" id="product">
  <div class="container">
    <div class="about-header">
      <p class="section-label">Cómo funciona</p>
      <h2 class="about-title">De dato censal a ruta óptima</h2>
      <p class="about-subtitle">
        Tres fases automatizadas. Semanas de análisis manual reducidas a
        minutos.
      </p>
    </div>

    <div class="steps-grid">
      <div class="step-card">
        <span class="step-number">01</span>
        <div class="step-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </div>
        <h3 class="step-title">Ingesta e integración</h3>
        <p class="step-text">
          Consolida Censo 2020, DENUE 2025 e Índice de Rezago Social en un
          repositorio unificado GeoPackage listo para procesar.
        </p>
        <span class="step-tag">INEGI · CONEVAL · OSM</span>
      </div>

      <div class="step-card step-card--featured">
        <span class="step-number step-number--light">02</span>
        <div class="step-icon step-icon--light">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
            <path d="M2 17l10 5 10-5"></path>
            <path d="M2 12l10 5 10-5"></path>
          </svg>
        </div>
        <h3 class="step-title step-title--light">Detección de demanda</h3>
        <p class="step-text step-text--light">
          K-Means segmenta el territorio identificando núcleos de concentración
          demográfica crítica sin sesgos manuales.
        </p>
        <span class="step-tag step-tag--light"
          >K-Means · GeoPandas · Scikit-learn</span
        >
      </div>

      <div class="step-card">
        <span class="step-number">03</span>
        <div class="step-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <polyline points="12 8 12 12 14 14"></polyline>
          </svg>
        </div>
        <h3 class="step-title">Optimización de rutas</h3>
        <p class="step-text">
          Dijkstra multi-source traza trayectorias de costo mínimo sobre
          vialidades de 4+ carriles hacia la red de metro existente.
        </p>
        <span class="step-tag">Dijkstra · OSMnx · NetworkX</span>
      </div>
    </div>

    <!-- Disclaimer simplificado -->
    <div class="disclaimer">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <line x1="12" y1="8" x2="12" y2="12"></line>
        <line x1="12" y1="16" x2="12.01" y2="16"></line>
      </svg>
      <p>
        Mycelium es un sistema de prefactibilidad geoespacial. No sustituye
        estudios de ingeniería civil, mecánica de suelos ni proyectos
        ejecutivos.
      </p>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: 80px 0;
  }

  /* Header */
  .about-header {
    text-align: center;
    margin-bottom: 56px;
  }

  .about-title {
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    color: var(--color-text-primary);
    margin-bottom: 12px;
  }

  .about-subtitle {
    font-size: 15px;
    color: var(--color-text-secondary);
    max-width: 480px;
    margin-inline: auto;
  }

  /* Grid de pasos */
  .steps-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 32px;
  }

  .step-card {
    background: var(--color-bg-card);
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .step-card--featured {
    background: var(--color-bg-dark);
    border-color: var(--color-bg-dark);
  }

  /* Número de paso */
  .step-number {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .step-number--light {
    color: rgba(255, 255, 255, 0.35);
  }

  /* Ícono */
  .step-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-bg-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-primary);
  }

  .step-icon--light {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  /* Título del paso */
  .step-title {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--color-text-primary);
    margin: 0;
  }

  .step-title--light {
    color: #fff;
  }

  /* Texto del paso */
  .step-text {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
    flex: 1;
  }

  .step-text--light {
    color: rgba(255, 255, 255, 0.55);
  }

  /* Tag de tecnología */
  .step-tag {
    display: inline-block;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 20px;
    background: var(--color-bg-muted);
    color: var(--color-text-muted);
    align-self: flex-start;
  }

  .step-tag--light {
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.4);
  }

  /* Disclaimer */
  .disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 16px 20px;
    background: var(--color-bg-muted);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    max-width: 720px;
    margin-inline: auto;
  }

  .disclaimer svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .disclaimer p {
    font-size: 13px;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  /* Desktop */
  @media (min-width: 768px) {
    .steps-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
