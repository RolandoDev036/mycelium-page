---
// Showcase.astro
const cases = [
  {
    title: "Conectividad Estratégica",
    description:
      "Algoritmos diseñados para integrar redes de transporte existentes con núcleos de demanda emergente",
    color: "linear-gradient(135deg, #4158D0 0%, #C850C0 100%)",
    img: "/monterrey_city.webp",
  },
  {
    title: "Prefactibilidad de Red",
    description:
      "Diagnóstico de potencial de demanda para ciudades que carecen de sistemas de transporte masivo.",
    color: "linear-gradient(135deg, #FF9A8B 0%, #FF6A88 55%, #FF99AC 100%)",
    img: "/transporte_masivo.webp",
  },
  {
    title: "Selección Modular",
    description:
      "Análisis flexible de cualquier zona geográfica de México mediante la ingesta de datos del INEGI.",
    color: "linear-gradient(135deg, #2c3e50 0%, #000000 100%)",
    img: "/municipios_modular.webp",
  },
];
---

<section class="showcase-container">
  <div class="showcase-header">
    <h2 class="showcase-title">Versatilidad y Escalabilidad Nacional</h2>
    <p class="showcase-subtitle">
      Mycelium es un sistema agnóstico a la infraestructura previa, capaz de
      dimensionar redes en cualquier metrópoli del país mediante la integración
      de los insumos oficiales del Marco Geoestadístico del INEGI.
    </p>
  </div>

  <div class="showcase-slider">
    {
      cases.map((c) => (
        <div class="showcase-card" style={{ background: c.color }}>
          <div class="card-img-container">
            <img src={c.img} alt={c.title} class="card-img" />
          </div>
          <div class="card-text">
            <h3 class="info-title">{c.title}</h3>
            <p class="info-text">{c.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .showcase-container {
    padding: 80px 0; /* Quitamos padding lateral para que el carrusel llegue al borde */
    overflow: hidden;
  }

  .showcase-header {
    text-align: center;
    margin-bottom: 60px;
    padding: 0 20px;
  }

  .showcase-title {
    font-size: 3em;
    font-weight: 800;
  }

  .showcase-subtitle {
    color: var(--text-secondary, #666);
    margin: 20px auto 0;
    font-size: 1.1rem;
    width: 90%;
    max-width: 700px;
  }

  /* --- CORRECCIÓN DEL CARRUSEL --- */
  .showcase-slider {
    display: flex;
    justify-content: flex-start; /* Alineado al inicio para permitir desborde */
    gap: 24px;
    padding: 20px 40px; /* Padding para que la primera tarjeta no pegue al borde */
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .showcase-slider::-webkit-scrollbar {
    display: none;
  }

  .showcase-card {
    flex: 0 0 85vw; /* En móvil ocupa casi todo el ancho */
    max-width: 450px; /* En desktop se limita */
    min-height: 450px;
    border-radius: 32px;
    scroll-snap-align: center;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: transform 0.3s ease;
    box-sizing: border-box;
  }

  /* --- AJUSTES DE IMAGEN Y TEXTO --- */
  .card-img-container {
    width: 100%;
    height: 200px;
    overflow: hidden;
    border-radius: 18px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
  }

  .card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-text {
    color: white;
    text-align: left;
  }

  .info-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .info-text {
    font-size: 1rem;
    opacity: 0.9;
    line-height: 1.5;
  }

  /* --- RESPONSIVE DESKTOP --- */
  @media (min-width: 1024px) {
    .showcase-slider {
      justify-content: center; /* Solo centramos si caben todas */
      padding: 40px;
    }

    .showcase-card {
      flex: 0 0 400px;
    }
  }

  @media (max-width: 768px) {
    .showcase-card:hover {
      transform: none; /* Evitamos saltos en touch */
    }

    .showcase-title {
      font-size: 2em;
      font-weight: 800;
    }
  }
</style>
